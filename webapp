              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-semibold text-slate-600 mb-1">Mata Pelajaran</label>
                  <select 
                    value={newMaterial.subject}
                    onChange={(e) => setNewMaterial({ ...newMaterial, subject: e.target.value })}
                    className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl"
                  >
                    <option value="Matematika">Matematika</option>
                    <option value="Fisika">Fisika</option>
                    <option value="Kimia">Kimia</option>
                    <option value="Biologi">Biologi</option>
                    <option value="Sosiologi">Sosiologi</option>
                    <option value="Bahasa Indonesia">Bahasa Indonesia</option>
                    <option value="Bahasa Inggris">Bahasa Inggris</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-semibold text-slate-600 mb-1">Target Kelas</label>
                  <select 
                    value={newMaterial.gradeClass}
                    onChange={(e) => setNewMaterial({ ...newMaterial, gradeClass: e.target.value })}
                    className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl"
                  >
                    <option value="10">Kelas 10</option>
                    <option value="11">Kelas 11</option>
                    <option value="12">Kelas 12</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Format Dokumen</label>
                <select 
                  value={newMaterial.type}
                  onChange={(e) => setNewMaterial({ ...newMaterial, type: e.target.value })}
                  className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl"
                >
                  <option value="PDF">E-Book / PDF Reader</option>
                  <option value="Video">Video Interaktif (YouTube Link)</option>
                </select>
              </div>

              {newMaterial.type === 'Video' && (
                <div>
                  <label className="block text-xs font-semibold text-slate-600 mb-1">Link YouTube Video</label>
                  <input 
                    type="text" 
                    required
                    value={newMaterial.youtubeUrl}
                    onChange={(e) => setNewMaterial({ ...newMaterial, youtubeUrl: e.target.value })}
                    placeholder="https://www.youtube.com/watch?v=..." 
                    className="w-full text-xs p-2.5 bg-slate-50 border border-indigo-250 rounded-xl"
                  />
                </div>
              )}

              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Ringkasan Singkat (Siswa / Orang Tua)</label>
                <textarea 
                  value={newMaterial.summary}
                  onChange={(e) => setNewMaterial({ ...newMaterial, summary: e.target.value })}
                  placeholder="Berikan rangkuman deskriptif ringkas..." 
                  className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl h-16"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Poin Rangkuman Detail (Pisahkan dengan baris baru)</label>
                <textarea 
                  value={newMaterial.contentPoints}
                  onChange={(e) => setNewMaterial({ ...newMaterial, contentPoints: e.target.value })}
                  placeholder="Poin pembahasan ke-1&#10;Poin pembahasan ke-2" 
                  className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl h-20"
                />
              </div>

              <div className="pt-4 flex justify-end gap-2 text-xs font-semibold">
                <button 
                  type="button"
                  onClick={() => setIsMaterialModalOpen(false)}
                  className="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
                >
                  Batal
                </button>
                <button 
                  type="submit"
                  className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition"
                >
                  Publish Materi
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* 5. MODAL TAMBAH TAGIHAN SPP */}
      {isSppModalOpen && (
        <div 
          onClick={() => setIsSppModalOpen(false)}
          className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50"
        >
          <div 
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-2xl shadow-xl w-full max-w-md p-6 relative"
          >
            <button 
              onClick={() => setIsSppModalOpen(false)}
              className="absolute right-4 top-4 text-slate-400 hover:text-slate-600"
            >
              <X className="h-5 w-5" />
            </button>
            <h3 className="text-lg font-bold text-slate-800 mb-4">Buat Tagihan SPP Bulanan Baru</h3>
            
            <form onSubmit={handleAddSppBill} className="space-y-4">
              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Pilih Siswa (Database)</label>
                <select 
                  value={newSpp.studentId}
                  onChange={(e) => setNewSpp({ ...newSpp, studentId: e.target.value })}
                  className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl"
                >
                  <option value="">-- Pilih Siswa --</option>
                  {users.filter(u => u.role === 'student').map(s => (
                    <option key={s.id} value={s.id}>{s.name} (Kelas {s.class})</option>
                  ))}
                </select>
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-semibold text-slate-600 mb-1">Bulan & Tahun</label>
                  <input 
                    type="text" 
                    value={newSpp.month}
                    onChange={(e) => setNewSpp({ ...newSpp, month: e.target.value })}
                    placeholder="Contoh: Juni 2026" 
                    className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-slate-600 mb-1">Nominal Tagihan (Rp)</label>
                  <input 
                    type="number" 
                    value={newSpp.amount}
                    onChange={(e) => setNewSpp({ ...newSpp, amount: e.target.value })}
                    placeholder="350000" 
                    className="w-full text-xs p-2.5 bg-slate-50 border rounded-xl"
                  />
                </div>
              </div>

              <div className="pt-4 flex justify-end gap-2 text-xs font-semibold">
                <button 
                  type="button"
                  onClick={() => setIsSppModalOpen(false)}
                  className="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
                >
                  Batal
                </button>
                <button 
                  type="submit"
                  className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition"
                >
                  Terbitkan Tagihan
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* 6. MODAL SIMULASI PEMBAYARAN SPP */}
      {isPaymentModalOpen && selectedStudentSpp && (
        <div 
          onClick={() => setIsPaymentModalOpen(false)}
          className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50"
        >
          <div 
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-2xl shadow-xl w-full max-w-md p-6 relative"
          >
            <button 
              onClick={() => setIsPaymentModalOpen(false)}
              className="absolute right-4 top-4 text-slate-400 hover:text-slate-600"
            >
              <X className="h-5 w-5" />
            </button>
            <h3 className="text-lg font-bold text-slate-800 mb-4">Gerbang Keuangan Pembayaran SPP</h3>

            <div className="space-y-4">
              <div className="p-4 bg-indigo-50 rounded-2xl border border-indigo-100 space-y-2">
                <div className="flex justify-between text-xs text-slate-600">
                  <span>Siswa Pembayar:</span>
                  <span className="font-semibold text-slate-800">{selectedStudentSpp.studentName}</span>
                </div>
                <div className="flex justify-between text-xs text-slate-600">
                  <span>Tagihan SPP Bulan:</span>
                  <span className="font-semibold text-slate-800">{selectedStudentSpp.month}</span>
                </div>
                <div className="border-t border-indigo-200/50 pt-2 flex justify-between text-sm font-bold text-indigo-900">
                  <span>Nominal Biaya:</span>
                  <span>Rp {selectedStudentSpp.amount.toLocaleString('id-ID')}</span>
                </div>
              </div>

              <div className="space-y-2">
                <p className="text-xs font-semibold text-slate-700">Pilih Opsi Pembayaran:</p>
                <div className="grid grid-cols-2 gap-2 text-xs">
                  <div className="p-3 border rounded-xl border-indigo-500 flex items-center gap-2 bg-indigo-50/50">
                    <span className="text-lg">💳</span>
                    <div>
                      <p className="font-bold text-indigo-900">Virtual Account</p>
                      <p className="text-[9px] text-indigo-600 font-medium">Verifikasi Cepat</p>
                    </div>
                  </div>
                  <div className="p-3 border rounded-xl flex items-center gap-2 bg-slate-50 cursor-pointer hover:border-indigo-300">
                    <span className="text-lg">📱</span>
                    <div>
                      <p className="font-semibold">QRIS Terintegrasi</p>
                      <p className="text-[9px] text-slate-400">Scan Instan</p>
                    </div>
                  </div>
                </div>
              </div>

              <div className="bg-slate-50 p-3 rounded-xl border border-slate-200 flex items-start gap-2 text-[10px] text-slate-500">
                <Info className="h-4 w-4 text-slate-400 shrink-0 mt-0.5" />
                <p>Klik 'Konfirmasi Pembayaran' untuk melakukan simulasi pelunasan tagihan. Status keuangan di database lokal akan otomatis diubah menjadi 'Lunas'.</p>
              </div>

              <div className="pt-4 flex justify-end gap-2 text-xs font-semibold">
                <button 
                  onClick={() => setIsPaymentModalOpen(false)}
                  className="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
                >
                  Batal
                </button>
                <button 
                  onClick={() => handlePaySpp(selectedStudentSpp.id)}
                  className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition shadow"
                >
                  Konfirmasi Pembayaran
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* 7. VERIFIKASI LOGOUT GANDA (Mencegah ketidaksengajaan klik keluar) */}
      {isLogoutConfirmOpen && (
        <div 
          onClick={() => setIsLogoutConfirmOpen(false)}
          className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50"
        >
          <div 
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center space-y-4"
          >
            <div className="inline-block p-3 bg-rose-50 text-rose-600 rounded-full">
              <AlertCircle className="h-8 w-8" />
            </div>
            
            <div>
              <h3 className="text-lg font-bold text-slate-800">Yakin ingin keluar?</h3>
              <p className="text-xs text-slate-500 mt-1">Sesi belajar dan kelola data Anda di EduSmart Hub akan diakhiri demi alasan keamanan data.</p>
            </div>

            <div className="pt-2 flex gap-3">
              <button 
                onClick={() => setIsLogoutConfirmOpen(false)}
                className="flex-1 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl text-xs font-bold transition text-slate-600"
              >
                Kembali Belajar
              </button>
              <button 
                onClick={handleLogout}
                className="flex-1 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold transition shadow-md shadow-rose-100"
              >
                Ya, Keluar Portal
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
