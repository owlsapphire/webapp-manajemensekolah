  const [sidebarOpen, setSidebarOpen] = useState(false);
  
  // Database States
  const [users, setUsers] = useState(initialUsers);
  const [grades, setGrades] = useState(initialGrades);
  const [materials, setMaterials] = useState(initialMaterials);
  const [sppList, setSppList] = useState(initialSpp);

  // Filters
  const [classFilter, setClassFilter] = useState('all'); 
  const [subjectFilter, setSubjectFilter] = useState('all');
  const [audienceRoleFilter, setAudienceRoleFilter] = useState('all'); // 'all', 'admin', 'student'

  // Modal Control States
  const [isGradeModalOpen, setIsGradeModalOpen] = useState(false);
  const [isMaterialModalOpen, setIsMaterialModalOpen] = useState(false);
  const [isSppModalOpen, setIsSppModalOpen] = useState(false);
  const [isPaymentModalOpen, setIsPaymentModalOpen] = useState(false);
  const [isLogoutConfirmOpen, setIsLogoutConfirmOpen] = useState(false);
  const [selectedStudentSpp, setSelectedStudentSpp] = useState(null);
  
  // Expand/Detail state for simplified Grades view
  const [viewingStudentDetail, setViewingStudentDetail] = useState(null);
  
  // Interactive Material Popup State
  const [selectedMaterial, setSelectedMaterial] = useState(null);
  
  // PDF Reader Interactive Simulation State
  const [pdfPage, setPdfPage] = useState(1);
  const [pdfZoom, setPdfZoom] = useState(100);

  // Form input records
  const [newGrade, setNewGrade] = useState({ studentId: '', subject: 'Matematika', score: '', type: 'UTS', semester: 'Ganjil 2026' });
  const [newMaterial, setNewMaterial] = useState({ title: '', subject: 'Matematika', gradeClass: '10', type: 'PDF', youtubeUrl: '', summary: '', contentPoints: '' });
  const [newSpp, setNewSpp] = useState({ studentId: '', month: 'Juni 2026', amount: 350000 });

  // Notifications
  const [toast, setToast] = useState({ show: false, message: '', type: 'success' });
  const [smsLogs, setSmsLogs] = useState([
    { id: '1', to: '081234567890 (Ahmad Fauzi / Wali)', message: 'SMS Pengingat SPP Mei 2026 Terkirim.', time: '04 Jun 2026, 09:00', status: 'Sent' }
  ]);

  const showToast = (message, type = 'success') => {
    setToast({ show: true, message, type });
    setTimeout(() => {
      setToast({ show: false, message: '', type: 'success' });
    }, 4000);
  };

  // Helper conversion for standard YouTube link to embed url
  const getYouTubeEmbedUrl = (url) => {
    if (!url) return '';
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=|shorts\/)([^#\&\?]*).*/;
    const match = url.match(regExp);
    if (match && match[2].length === 11) {
      return `https://www.youtube.com/embed/${match[2]}`;
    }
    return url;
  };

  const handleLogin = (e) => {
    e.preventDefault();
    if (!authEmail || !authPassword) {
      showToast('Harap isi semua kolom email dan kata sandi!', 'error');
      return;
    }

    const foundUser = users.find(u => u.email.toLowerCase() === authEmail.toLowerCase() && u.password === authPassword);
    if (foundUser) {
      setCurrentUser(foundUser);
      const firstStudent = users.find(u => u.role === 'student');
      setNewGrade(prev => ({ ...prev, studentId: firstStudent ? firstStudent.id : '' }));
      setNewSpp(prev => ({ ...prev, studentId: firstStudent ? firstStudent.id : '' }));
      showToast(`Selamat datang kembali, ${foundUser.name}!`);
      setAuthEmail('');
      setAuthPassword('');
    } else {
      showToast('Kombinasi email atau kata sandi salah!', 'error');
    }
  };

  const handleSignup = (e) => {
    e.preventDefault();
    if (!authName || !authEmail || !authPassword || !authPhone) {
      showToast('Harap lengkapi semua kolom wajib!', 'error');
      return;
    }

    if (users.some(u => u.email.toLowerCase() === authEmail.toLowerCase())) {
      showToast('Email ini sudah terdaftar!', 'error');
      return;
    }

    const newId = 'u' + (users.length + 1);
    const registeredUser = {
      id: newId,
      name: authName,
      email: authEmail,
      password: authPassword,
      role: authRole,
      phone: authPhone,
      class: authRole === 'student' ? authClass : '-',
      nis: authRole === 'student' ? (authNis || 'Belum Diisi') : '-'
    };

    setUsers([...users, registeredUser]);
    setCurrentUser(registeredUser);
    
    showToast(`Registrasi Berhasil! Anda masuk sebagai ${authName}`);
    
    setAuthName('');
    setAuthEmail('');
    setAuthPassword('');
    setAuthPhone('');
    setAuthNis('');
    setAuthClass('10');
  };

  const handleLogout = () => {
    setCurrentUser(null);
    setIsLogoutConfirmOpen(false);
    setActiveTab('dashboard');
    showToast('Anda telah berhasil keluar sistem.');
  };

  const handleAddGrade = (e) => {
    e.preventDefault();
    const targetStudentId = newGrade.studentId || (users.find(u => u.role === 'student')?.id);
    if (!targetStudentId) {
      showToast('Siswa tidak valid!', 'error');
      return;
    }
    if (!newGrade.score || isNaN(newGrade.score)) {
      showToast('Masukkan nilai angka yang valid!', 'error');
      return;
    }

    const student = users.find(s => s.id === targetStudentId);
    const gradeData = {
      id: 'g' + (grades.length + 1),
      studentId: targetStudentId,
      studentName: student ? student.name : 'Unknown',
      subject: newGrade.subject,
      score: parseInt(newGrade.score),
      type: newGrade.type,
      semester: newGrade.semester
    };

    setGrades([gradeData, ...grades]);
    setIsGradeModalOpen(false);
    setNewGrade({ studentId: targetStudentId, subject: 'Matematika', score: '', type: 'UTS', semester: 'Ganjil 2026' });
    showToast(`Berhasil menambahkan nilai untuk ${student ? student.name : 'Siswa'}!`);
  };

  const handleAddMaterial = (e) => {
    e.preventDefault();
    if (!newMaterial.title || !newMaterial.summary) {
      showToast('Judul dan ringkasan materi tidak boleh kosong!', 'error');
      return;
    }

    if (newMaterial.type === 'Video' && !newMaterial.youtubeUrl) {
      showToast('Link YouTube wajib diisi untuk format Video!', 'error');
      return;
    }

    const contentPointsArray = newMaterial.contentPoints 
      ? newMaterial.contentPoints.split('\n').filter(p => p.trim() !== '')
      : ['Materi bab ini siap dipelajari.', 'Gunakan rangkuman untuk tinjauan mandiri.'];

    const materialData = {
      id: 'm' + (materials.length + 1),
      title: newMaterial.title,
      subject: newMaterial.subject,
      gradeClass: newMaterial.gradeClass,
      type: newMaterial.type,
      youtubeUrl: newMaterial.type === 'Video' ? getYouTubeEmbedUrl(newMaterial.youtubeUrl) : undefined,
      author: currentUser ? currentUser.name : 'Guru/Admin',
      date: new Date().toISOString().split('T')[0],
      summary: newMaterial.summary,
      briefContent: contentPointsArray,
      pagesCount: newMaterial.type === 'PDF' ? Math.floor(Math.random() * 10) + 5 : undefined,
    };

    setMaterials([materialData, ...materials]);
    setIsMaterialModalOpen(false);
    setNewMaterial({ title: '', subject: 'Matematika', gradeClass: '10', type: 'PDF', youtubeUrl: '', summary: '', contentPoints: '' });
    showToast('Materi Pembelajaran berhasil dipublikasikan!');
  };

  const handleAddSppBill = (e) => {
    e.preventDefault();
    const targetStudentId = newSpp.studentId || (users.find(u => u.role === 'student')?.id);
    if (!targetStudentId) {
      showToast('Harap pilih siswa!', 'error');
      return;
    }

    const student = users.find(s => s.id === targetStudentId);
    const sppData = {
      id: 's' + (sppList.length + 1),
      studentId: targetStudentId,
      studentName: student ? student.name : 'Unknown',
      month: newSpp.month,
      amount: parseInt(newSpp.amount),
      status: 'Belum Lunas',
      payDate: null
    };

    setSppList([sppData, ...sppList]);
    setIsSppModalOpen(false);
    showToast(`Tagihan SPP baru untuk ${student ? student.name : 'Siswa'} berhasil dibuat!`);
  };

  const sendWhatsAppReminder = (spp) => {
    const student = users.find(s => s.id === spp.studentId);
    if (!student) return;

    let cleaned = student.phone.replace(/\D/g, '');
    if (cleaned.startsWith('0')) {
      cleaned = '62' + cleaned.substring(1);
    }

    const waText = `Halo Bapak/Ibu Wali Murid dari *${student.name}* (NIS: ${student.nis}),\n\nKami menginformasikan bahwa tagihan SPP untuk bulan *${spp.month}* sebesar *Rp ${spp.amount.toLocaleString('id-ID')}* masih belum lunas. Mohon untuk segera melakukan pembayaran demi kelancaran proses pembelajaran.\n\n_Pembayaran dapat disimulasikan langsung lewat dashboard EduSmart Hub._\n\nTerima kasih.\n— Administrasi Sekolah`;
    const messageText = encodeURIComponent(waText);
    const waUrl = `https://api.whatsapp.com/send?phone=${cleaned}&text=${messageText}`;
    
    window.open(waUrl, '_blank');
    showToast(`Membuka WhatsApp untuk mengirim pesan ke Wali ${student.name}!`);
  };

  const sendSMSReminder = (spp) => {
    const student = users.find(s => s.id === spp.studentId);
    if (!student) return;

    const newLog = {
      id: String(smsLogs.length + 1),
      to: `${student.phone} (${student.name} / Wali)`,
      message: `SMS SPP REMINDER: Yth Wali Murid ${student.name}, SPP bulan ${spp.month} sebesar Rp ${spp.amount.toLocaleString('id-ID')} belum dibayar. Mohon segera melunasi. Tks.`,
      time: new Date().toLocaleString('id-ID', { hour12: false }),
      status: 'Sent'
    };

    setSmsLogs([newLog, ...smsLogs]);
    showToast(`Notifikasi SMS berhasil disimulasikan terkirim ke Wali ${student.name}!`);
  };

  const handlePaySpp = (sppId) => {
    const updatedSppList = sppList.map(item => {
      if (item.id === sppId) {
        return { ...item, status: 'Lunas', payDate: new Date().toISOString().split('T')[0] };
      }
      return item;
    });
    setSppList(updatedSppList);
    setIsPaymentModalOpen(false);
    showToast('Pembayaran SPP berhasil diproses!');
  };

